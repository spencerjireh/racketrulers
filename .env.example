# Supabase Postgres (direct connection for single-container deploys)
# For serverless (Vercel), use the transaction pooler on port 6543 for DATABASE_URL
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
AUTH_SECRET="change-me-generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Soketi (server-side)
SOKETI_APP_ID="your-app-id"
SOKETI_APP_KEY="your-app-key"
SOKETI_APP_SECRET="your-app-secret"
SOKETI_HOST="your-soketi-host.example.com"
SOKETI_PORT="443"
SOKETI_USE_TLS="true"

# Soketi (client-side)
NEXT_PUBLIC_SOKETI_KEY="your-app-key"
NEXT_PUBLIC_SOKETI_HOST="your-soketi-host.example.com"
NEXT_PUBLIC_SOKETI_PORT="443"

# Invite codes (comma-separated) for organizer signup
INVITE_CODES="RACK-2025-ALPHA,RACK-2025-BETA"
