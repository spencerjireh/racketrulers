generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth Models (Auth.js) ───────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?

  accounts    Account[]
  sessions    Session[]
  tournaments Tournament[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Account {
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ─── Tournament Models ───────────────────────────────────────────────────────

enum TournamentStatus {
  PENDING
  UNDERWAY
  COMPLETE

  @@map("event_status")
}

model Tournament {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  bannerUrl   String?          @map("banner_url")
  status      TournamentStatus @default(PENDING)
  startDate   DateTime         @map("start_date")
  endDate     DateTime         @map("end_date")

  format       TournamentFormat?
  drawsAllowed Boolean @default(false) @map("draws_allowed")

  // Challonge-aligned fields
  type                 String  @default("SINGLE_STAGE")
  thirdPlaceMatch      Boolean @default(false) @map("third_place_match")
  grandFinalsModifier  String? @map("grand_finals_modifier")
  rankBy               String  @default("MATCH_WINS") @map("rank_by")
  hideSeeds            Boolean @default(false) @map("hide_seeds")
  quickAdvance         Boolean @default(false) @map("quick_advance")
  showStandings        Boolean @default(true) @map("show_standings")

  pointsConfig     Json @default("{\"win\": 2, \"draw\": 1, \"loss\": 0}") @map("points_config")
  scoringConfig    Json @default("{\"pointsPerSet\": 21, \"totalSets\": 3, \"deuceEnabled\": true, \"maxPoints\": 30}") @map("scoring_config")
  scheduleConfig   Json @default("{\"slotDuration\": 30, \"dayStartHour\": 8, \"dayEndHour\": 20}") @map("schedule_config")
  tiebreakerConfig Json @default("{\"order\": [\"win_loss\", \"head_to_head\", \"point_differential\", \"points_scored\"]}") @map("tiebreaker_config")

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id])

  deletedAt DateTime? @map("deleted_at")

  matches      Match[]
  participants Participant[]
  locations    Location[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([deletedAt])
  @@map("tournaments")
}

enum TournamentFormat {
  ROUND_ROBIN
  SWISS
  SINGLE_ELIM
  DOUBLE_ELIM

  @@map("round_type")
}

enum MatchStatus {
  PENDING
  OPEN
  COMPLETE
  FORFEIT

  @@map("game_status")
}

enum MatchType {
  SINGLES
  DOUBLES

  @@map("match_type")
}

model Match {
  id             String      @id @default(cuid())
  status         MatchStatus @default(PENDING) @map("status")
  matchType      MatchType   @default(SINGLES) @map("match_type")
  roundPosition  Int?        @map("round_position")
  round          Int?        @map("round")
  scheduledAt    DateTime?   @map("scheduled_at")
  durationMinutes Int        @default(60) @map("duration_minutes")

  scoreParticipant1 Int? @map("score_participant1")
  scoreParticipant2 Int? @map("score_participant2")
  setScores         Json? @map("set_scores")

  participant1Id String?      @map("participant1_id")
  participant1   Participant? @relation("MatchParticipant1", fields: [participant1Id], references: [id])

  participant2Id String?      @map("participant2_id")
  participant2   Participant? @relation("MatchParticipant2", fields: [participant2Id], references: [id])

  tournamentId String     @map("tournament_id")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  locationId String?   @map("location_id")
  location   Location? @relation(fields: [locationId], references: [id])

  feederMatch1Id String? @map("feeder_match_1_id")
  feederMatch1   Match?  @relation("FeederMatch1", fields: [feederMatch1Id], references: [id])
  fedByMatch1    Match[] @relation("FeederMatch1")

  feederMatch2Id String? @map("feeder_match_2_id")
  feederMatch2   Match?  @relation("FeederMatch2", fields: [feederMatch2Id], references: [id])
  fedByMatch2    Match[] @relation("FeederMatch2")

  feederMatch1IsLoser Boolean @default(false) @map("feeder_match_1_is_loser")
  feederMatch2IsLoser Boolean @default(false) @map("feeder_match_2_is_loser")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tournamentId, status])
  @@map("games")
}

model Participant {
  id           String  @id @default(cuid())
  name         String
  captainName  String? @map("captain_name")
  captainEmail String? @map("captain_email")
  roster       Json    @default("[]")
  seed         Int     @default(0)

  tournamentId String     @map("tournament_id")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  matchesAsParticipant1 Match[] @relation("MatchParticipant1")
  matchesAsParticipant2 Match[] @relation("MatchParticipant2")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("teams")
}

model Location {
  id   String @id @default(cuid())
  name String

  tournamentId String     @map("tournament_id")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  matches Match[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("locations")
}

// ─── Coach Scheduler Models ──────────────────────────────────────────────────

model CoachProfile {
  id                     String @id @default(cuid())
  displayName            String @map("display_name")
  slug                   String @unique
  sessionDurationMinutes Int    @default(60) @map("session_duration_minutes")

  availability CoachAvailability[]
  bookings     Booking[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("coach_profiles")
}

model CoachAvailability {
  id        String @id @default(cuid())
  dayOfWeek Int    @map("day_of_week") // 0-6, Monday=0
  startTime String @map("start_time") // e.g. "09:00"
  endTime   String @map("end_time")   // e.g. "12:00"

  coachProfileId String       @map("coach_profile_id")
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("coach_availability")
}

enum BookingStatus {
  CONFIRMED
  CANCELLED

  @@map("booking_status")
}

model Booking {
  id          String        @id @default(cuid())
  date        DateTime      @db.Date
  startTime   String        @map("start_time")
  endTime     String        @map("end_time")
  bookerName  String        @map("booker_name")
  bookerEmail String        @map("booker_email")
  message     String?
  status      BookingStatus @default(CONFIRMED)

  coachProfileId String       @map("coach_profile_id")
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([coachProfileId, date])
  @@map("bookings")
}
